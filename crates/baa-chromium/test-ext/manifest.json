{
  "manifest_version": 3,
  "name": "baa probe",
  "version": "1",
  "description": "Probe for baa's harness",
  "permissions": ["tabs", "tabGroups", "activeTab", "contextMenus"],
  "optional_permissions": ["bookmarks"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_popup": "popup.html" }
}
