# everything in one run, with a popup still open at quit
script: all.txt
ext: yes
env: BAA_HARNESS_PERMISSION=allow
env: BAA_HARNESS_DIALOG=ok
env: BAA_HARNESS_MENU=Copy Link Address
secs: 120
must: baa: answer id=\d+ allow
must: baa: context_menu_done id=\d+ command=50104
must: baa: popup \w{32} -> 2
must: baa: dialog tab=0 id=\d+ kind=3
must: baa: tab_closed tab=2 reason=\d
