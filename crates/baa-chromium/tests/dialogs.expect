# alert/confirm/prompt through baa_answer, request_closed on navigation, permissions denied, stale handles
script: dialogs.txt
env: BAA_HARNESS_PERMISSION=deny
must: baa: dialog tab=0 id=\d+ kind=0
must: baa: dialog tab=0 id=\d+ kind=1
must: baa: dialog tab=0 id=\d+ kind=2 .*default="dflt"
must: baa: request_closed tab=0 id=\d+
must: title="confirm:false"
must: title="prompt:bob"
must: title="after-alert"
must: title="geo-err:1"
must: title="notif:denied"
