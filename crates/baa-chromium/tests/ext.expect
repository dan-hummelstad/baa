# extension list, popup on the real active tab, alert in the popup, site access, disable, remove
script: ext.txt
ext: yes
env: BAA_HARNESS_DIALOG=ok
must: baa: extension id=\w{32} name="baa probe" .*enabled=1
must: baa: popup \w{32} -> 1
must: baa: resized tab=1 \d+x\d+
must: title="active:https://example.com/"
must: baa: dialog tab=1 id=1 kind=0 message="from popup"
must: ext \w{32} access 1 -> true
must: site_access=1
must: enabled=0
must: baa: tab_closed tab=1
must: baa: extensions count=0
