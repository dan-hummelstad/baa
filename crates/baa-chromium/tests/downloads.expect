# downloads start, report progress and the source tab, finish; a slow one is cancelled
script: downloads.txt
server: yes
env: BAA_HARNESS_DOWNLOAD_CANCEL=2000000
must: baa: download tab=0 id=\d+ url=\S+/small path=\S+ received=18000 total=18000 state=1
must: baa: download_cancel id=\d+
must: baa: download tab=0 id=\d+ .* state=2
mustnot: baa: download tab=0 id=\d+ url=\S+/slow .* state=1
