+// baa: like the Magic Mouse path, with //baa drawing the swipe. The navigation
+// waits for the settle animation, so the page //baa slides never shows the
+// destination mid-slide.
+- (void)baaTrackSwipe:(BOOL)forward event:(NSEvent*)event {
+  NSView* view = [self.delegate viewThatWantsHistoryOverlay];
+  void* key = (__bridge void*)view;
+  __block BOOL committed = NO;
+  [event trackSwipeEventWithOptions:NSEventSwipeTrackingLockDirection
+           dampenAmountThresholdMin:-1
+                                max:1
+                       usingHandler:^(CGFloat gestureAmount, NSEventPhase phase,
+                                      BOOL isComplete, BOOL* stop) {
+                         if (phase == NSEventPhaseEnded) {
+                           committed = YES;
+                         }
+                         double amount = std::abs(gestureAmount);
+                         if (!isComplete) {
+                           g_baa_history_swipe(
+                               key, phase == NSEventPhaseBegan ? 0 : 1,
+                               forward, amount);
+                           return;
+                         }
+                         g_baa_history_swipe(key, committed ? 2 : 3, forward,
+                                             committed ? 1.0 : 0.0);
+                         if (committed) {
+                           [self.delegate
+                               navigateInDirection:forward
+                                                       ? history_swiper::kForwards
+                                                       : history_swiper::kBackwards
+                                          onWindow:view.window];
+                         }
+                       }];
