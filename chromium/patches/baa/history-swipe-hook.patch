+// baa: lets the embedding app (//baa) draw history swipes itself.
+// //chrome cannot depend on //baa, so //baa sets this pointer. Null keeps
+// Chrome's arrow overlay.
+#ifndef CHROME_BROWSER_RENDERER_HOST_BAA_HISTORY_SWIPE_HOOK_H_
+#define CHROME_BROWSER_RENDERER_HOST_BAA_HISTORY_SWIPE_HOOK_H_
+
+// A two-finger history swipe over the page whose RenderWidgetHostView NSView
+// is `view`. `phase` is one of //baa's BAA_SWIPE_* (0 began, 1 changed, 2 done
+// and the navigation follows, 3 cancelled); `amount` runs 0..1, how far across.
+// The swipe never goes where the tab cannot (Chrome checks first).
+using BaaHistorySwipeFn = void (*)(void* view,
+                                   int phase,
+                                   bool forward,
+                                   double amount);
+extern BaaHistorySwipeFn g_baa_history_swipe;
+
+#endif  // CHROME_BROWSER_RENDERER_HOST_BAA_HISTORY_SWIPE_HOOK_H_
