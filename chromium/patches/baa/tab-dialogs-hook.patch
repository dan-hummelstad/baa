--- a/chrome/browser/ui/views/tab_dialogs_views.h
+++ b/chrome/browser/ui/views/tab_dialogs_views.h
@@ -7,6 +7,17 @@
 
 #include "base/memory/raw_ptr.h"
 #include "chrome/browser/ui/tab_dialogs.h"
+
+// baa: the embedding app (//baa) shows the hung-page prompt itself for the tabs
+// it draws. //chrome cannot depend on //baa, so //baa sets these. Each returns
+// false to leave the tab to Chrome's views dialog.
+struct BaaHungRendererHook {
+  bool (*show)(content::WebContents*, content::RenderWidgetHost*,
+               base::RepeatingClosure& hang_monitor_restarter) = nullptr;
+  bool (*hide)(content::WebContents*, content::RenderWidgetHost*) = nullptr;
+  bool (*is_showing)(content::WebContents*, bool* showing) = nullptr;
+};
+extern BaaHungRendererHook g_baa_hung_renderer_hook;
 
 // Views implementation of TabDialogs interface.
 class TabDialogsViews : public TabDialogs {
--- a/chrome/browser/ui/views/tab_dialogs_views.cc
+++ b/chrome/browser/ui/views/tab_dialogs_views.cc
@@ -18,6 +18,8 @@
 #include "chrome/browser/ui/views/web_apps/force_installed_deprecated_apps_dialog_view.h"
 #include "chrome/browser/ui/views/web_apps/force_installed_preinstalled_deprecated_app_dialog_view.h"
 #endif
+
+BaaHungRendererHook g_baa_hung_renderer_hook;
 
 // static
 std::unique_ptr<TabDialogs> TabDialogs::Create(tabs::TabInterface& tab,
@@ -46,16 +48,30 @@
 void TabDialogsViews::ShowHungRendererDialog(
     content::RenderWidgetHost* render_widget_host,
     base::RepeatingClosure hang_monitor_restarter) {
+  if (g_baa_hung_renderer_hook.show &&
+      g_baa_hung_renderer_hook.show(web_contents_, render_widget_host,
+                                    hang_monitor_restarter)) {
+    return;
+  }
   HungRendererDialogView::Show(web_contents_, render_widget_host,
                                std::move(hang_monitor_restarter));
 }
 
 void TabDialogsViews::HideHungRendererDialog(
     content::RenderWidgetHost* render_widget_host) {
+  if (g_baa_hung_renderer_hook.hide &&
+      g_baa_hung_renderer_hook.hide(web_contents_, render_widget_host)) {
+    return;
+  }
   HungRendererDialogView::Hide(web_contents_, render_widget_host);
 }
 
 bool TabDialogsViews::IsShowingHungRendererDialog() {
+  bool showing = false;
+  if (g_baa_hung_renderer_hook.is_showing &&
+      g_baa_hung_renderer_hook.is_showing(web_contents_, &showing)) {
+    return showing;
+  }
   return HungRendererDialogView::IsShowingForWebContents(web_contents_);
 }
 
