 std::vector<GURL> ChromeConfigurator::UpdateUrl() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // baa: WidevineCdm is the only component left (component_installer.cc), and
+  // it is registered only with this pref on (registration.cc). It comes from
+  // Google's server, as in Chrome: there is no Helium proxy in baa.
+  if (pref_service_->GetBoolean(prefs::kBaaWidevineEnabled)) {
+    return {GURL("https://update.googleapis.com/service/update2/json")};
+  }
   return {helium::GetComponentUpdateURL(GetProfilePrefs())};
 }
 
