+void VideoOverlayWindowViews::OnScrollEvent(ui::ScrollEvent* event) {
+  // baa: a two-finger flick on the trackpad sends the window to the corner in
+  // that direction. AppKit marks a trackpad stroke with a begin phase (a mouse
+  // wheel has none), then finger updates, then momentum, which is ignored.
+  // ponytail: offsets follow the fingers under natural scrolling (the macOS
+  // default); with it off a flick goes the opposite way. Read
+  // NSEvent.isDirectionInvertedFromDevice if anyone asks.
+  if (event->type() != ui::EventType::kScroll) {
+    views::Widget::OnScrollEvent(event);
+    return;
+  }
+  switch (event->momentum_phase()) {
+    case ui::EventMomentumPhase::MAY_BEGIN:
+      flick_ = gfx::Vector2dF();
+      flick_armed_ = true;
+      break;
+    case ui::EventMomentumPhase::NONE:
+      if (!flick_armed_) {
+        break;
+      }
+      flick_ += gfx::Vector2dF(event->x_offset(), event->y_offset());
+      if (flick_.Length() >= kFlickDistance) {
+        flick_armed_ = false;
+        const gfx::Rect bounds = GetWindowBoundsInScreen();
+        const gfx::Rect area = GetWorkAreaForWindow();
+        bool right = bounds.CenterPoint().x() > area.CenterPoint().x();
+        bool bottom = bounds.CenterPoint().y() > area.CenterPoint().y();
+        // A mostly sideways flick keeps the row; a diagonal one changes both.
+        const float x = std::abs(flick_.x()), y = std::abs(flick_.y());
+        if (x >= y * 0.5f) {
+          right = flick_.x() > 0;
+        }
+        if (y >= x * 0.5f) {
+          bottom = flick_.y() > 0;
+        }
+        GlideToCorner(right, bottom);
+      }
+      break;
+    default:
+      flick_armed_ = false;
+      break;
+  }
+  event->SetHandled();
+}
+
+void VideoOverlayWindowViews::GlideTo(const gfx::Point& origin) {
+  glide_target_ = origin;
+  if (!glide_timer_.IsRunning()) {
+    glide_timer_.Start(FROM_HERE, base::Hertz(120), this,
+                       &VideoOverlayWindowViews::GlideStep);
+  }
+}
+
+void VideoOverlayWindowViews::GlideToCorner(bool right, bool bottom) {
+  gfx::Rect area = GetWorkAreaForWindow();
+  area.Inset(kCornerMargin);
+  const gfx::Size size = GetWindowBoundsInScreen().size();
+  GlideTo({right ? area.right() - size.width() : area.x(),
+           bottom ? area.bottom() - size.height() : area.y()});
+}
+
+void VideoOverlayWindowViews::GlideStep() {
+  gfx::Rect bounds = GetWindowBoundsInScreen();
+  const gfx::Vector2d left = glide_target_ - bounds.origin();
+  if (std::abs(left.x()) <= 1 && std::abs(left.y()) <= 1) {
+    bounds.set_origin(glide_target_);
+    if (!dragging_) {
+      glide_timer_.Stop();
+    }
+  } else {
+    bounds.Offset(
+        gfx::ToRoundedVector2d(gfx::ScaleVector2d(gfx::Vector2dF(left), kGlideEase)));
+  }
+  if (bounds.origin() != GetWindowBoundsInScreen().origin()) {
+    SetBounds(bounds);
+  }
+}
