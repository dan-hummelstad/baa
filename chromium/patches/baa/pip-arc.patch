+bool VideoOverlayWindowViews::HandleDrag(ui::MouseEvent* event) {
+  const gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  switch (event->type()) {
+    case ui::EventType::kMousePressed:
+      // A press on a control is the control's.
+      if (event->IsOnlyLeftMouseButton() &&
+          !ControlsHitTestContainsPoint(event->location())) {
+        drag_start_ = cursor;
+        drag_origin_ = GetWindowBoundsInScreen().origin();
+        drag_last_cursor_ = cursor;
+        drag_last_time_ = now;
+        drag_velocity_ = gfx::Vector2dF();
+      }
+      return false;
+    case ui::EventType::kMouseDragged: {
+      if (!drag_start_) {
+        return false;
+      }
+      if (!dragging_ && (cursor - *drag_start_).LengthSquared() < 16) {
+        return true;
+      }
+      dragging_ = true;
+      const float dt = (now - drag_last_time_).InSecondsF();
+      if (dt > 0.001f) {
+        // Smoothed, so one late event does not throw the window.
+        drag_velocity_ = gfx::ScaleVector2d(drag_velocity_, 0.5f) +
+                         gfx::ScaleVector2d(gfx::Vector2dF(cursor - drag_last_cursor_),
+                                            0.5f / dt);
+      }
+      drag_last_cursor_ = cursor;
+      drag_last_time_ = now;
+      GlideTo(drag_origin_ + (cursor - *drag_start_));
+      return true;
+    }
+    case ui::EventType::kMouseReleased: {
+      if (!drag_start_) {
+        return false;
+      }
+      drag_start_.reset();
+      if (!dragging_) {
+        return false;
+      }
+      dragging_ = false;
+      // A pointer at rest before release throws nothing.
+      if ((now - drag_last_time_) > base::Milliseconds(80)) {
+        drag_velocity_ = gfx::Vector2dF();
+      }
+      const gfx::Rect area = GetWorkAreaForWindow();
+      const gfx::Size size = GetWindowBoundsInScreen().size();
+      // A slow drag leaves the window where it was let go, kept on screen.
+      if (drag_velocity_.Length() < kThrowSpeed) {
+        gfx::Rect at(glide_target_, size);
+        at.AdjustToFit(area);
+        GlideTo(at.origin());
+        return true;
+      }
+      // A throw: the corner nearest where it would carry the window's centre
+      // in a quarter second.
+      const gfx::PointF centre =
+          gfx::PointF(glide_target_.x() + size.width() / 2.f,
+                      glide_target_.y() + size.height() / 2.f) +
+          gfx::ScaleVector2d(drag_velocity_, 0.25f);
+      GlideToCorner(centre.x() > area.CenterPoint().x(),
+                    centre.y() > area.CenterPoint().y());
+      return true;
+    }
+    default:
+      return false;
+  }
+}
