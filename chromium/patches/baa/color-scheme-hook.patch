+// baa: lets the embedding app (//baa) pick prefers-color-scheme per page.
+// //chrome cannot depend on //baa, so //baa sets this pointer. Null keeps Chrome's behaviour.
+#ifndef CHROME_BROWSER_BAA_HOOKS_H_
+#define CHROME_BROWSER_BAA_HOOKS_H_
+
+#include "third_party/blink/public/mojom/webpreferences/web_preferences.mojom-shared.h"
+
+namespace content {
+class SecurityPrincipal;
+class WebContents;
+}  // namespace content
+
+// Returns true after setting `*scheme` for a document of `principal` in `contents`.
+using BaaPreferredColorSchemeFn = bool (*)(content::WebContents* contents,
+                                           const content::SecurityPrincipal& principal,
+                                           blink::mojom::PreferredColorScheme* scheme);
+extern BaaPreferredColorSchemeFn g_baa_preferred_color_scheme;
+
+#endif  // CHROME_BROWSER_BAA_HOOKS_H_
