--- /dev/null
+++ b/chrome/browser/ui/views/tab_contents/baa_context_menu_hook.h
@@ -0,0 +1,15 @@
+// baa: lets the embedding app (//baa) show a page's context menu itself.
+// //chrome cannot depend on //baa, so //baa sets this pointer.
+#ifndef CHROME_BROWSER_UI_VIEWS_TAB_CONTENTS_BAA_CONTEXT_MENU_HOOK_H_
+#define CHROME_BROWSER_UI_VIEWS_TAB_CONTENTS_BAA_CONTEXT_MENU_HOOK_H_
+
+#include <memory>
+
+class RenderViewContextMenuBase;
+
+// Returns true after moving `menu` out (the app then owns and shows it).
+using BaaShowContextMenuFn =
+    bool (*)(std::unique_ptr<RenderViewContextMenuBase>& menu);
+extern BaaShowContextMenuFn g_baa_show_context_menu;
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TAB_CONTENTS_BAA_CONTEXT_MENU_HOOK_H_
