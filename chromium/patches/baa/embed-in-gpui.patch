 + (AppController*)sharedController {
   static AppController* sharedController = [] {
     AppController* sharedController = [[AppController alloc] init];
-    NSApp.delegate = sharedController;
+    // baa: the embedding UI (gpui) owns NSApp's delegate; AppController only
+    // takes the role when nobody set one (the stock baa.app). Otherwise it
+    // still gets the delegate notifications it does start-up and shutdown
+    // work in (the last keep-alive goes in -applicationWillTerminate:).
+    if (!NSApp.delegate) {
+      NSApp.delegate = sharedController;
+    } else {
+      NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+      [center addObserver:sharedController
+                 selector:@selector(applicationWillFinishLaunching:)
+                     name:NSApplicationWillFinishLaunchingNotification
+                   object:NSApp];
+      [center addObserver:sharedController
+                 selector:@selector(applicationDidFinishLaunching:)
+                     name:NSApplicationDidFinishLaunchingNotification
+                   object:NSApp];
+      [center addObserver:sharedController
+                 selector:@selector(applicationWillTerminate:)
+                     name:NSApplicationWillTerminateNotification
+                   object:NSApp];
+    }
     return sharedController;
   }();
 
   CHECK_NE(nil, sharedController);
-  CHECK_EQ(NSApp.delegate, sharedController);
   return sharedController;
 }
 
