 // Returns true after setting `*scheme` for a document of `principal` in `contents`.
 using BaaPreferredColorSchemeFn = bool (*)(content::WebContents* contents,
                                            const content::SecurityPrincipal& principal,
                                            blink::mojom::PreferredColorScheme* scheme);
 extern BaaPreferredColorSchemeFn g_baa_preferred_color_scheme;
+
+// Dialog hooks: //baa draws these in the app's own UI. A hook that does not take the
+// request returns null/false and leaves its arguments untouched, so Chrome's dialog shows.
+using BaaLoginHandlerFn = std::unique_ptr<LoginHandler> (*)(
+    const net::AuthChallengeInfo& auth_info,
+    content::WebContents* web_contents,
+    content::LoginDelegate::LoginAuthRequiredCallback& auth_required_callback);
+extern BaaLoginHandlerFn g_baa_login_handler;
+
+using BaaExternalProtocolFn =
+    bool (*)(const GURL& url,
+             content::WebContents* web_contents,
+             const std::optional<url::Origin>& initiating_origin,
+             content::WeakDocumentPtr initiator_document,
+             const std::u16string& program_name);
+extern BaaExternalProtocolFn g_baa_external_protocol;
+
+using BaaInstallDialogFn = bool (*)(
+    std::unique_ptr<ExtensionInstallPromptShowParams>& show_params,
+    ExtensionInstallPrompt::DoneCallback& done_callback,
+    std::unique_ptr<extensions::InstallPromptData>& prompt);
+extern BaaInstallDialogFn g_baa_install_dialog;
 
 #endif  // CHROME_BROWSER_BAA_HOOKS_H_
