+// baa: lets the embedding app (//baa) show the URL of the link under the
+// pointer. //chrome cannot depend on //baa, so //baa sets this pointer. Null
+// keeps Chrome's status bubble.
+#ifndef CHROME_BROWSER_UI_BROWSER_WEB_CONTENTS_DELEGATE_BAA_TARGET_URL_HOOK_H_
+#define CHROME_BROWSER_UI_BROWSER_WEB_CONTENTS_DELEGATE_BAA_TARGET_URL_HOOK_H_
+
+class GURL;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// `url` is empty when the pointer left the link. Returns false to leave
+// `source` to Chrome's status bubble.
+using BaaTargetUrlFn = bool (*)(content::WebContents* source, const GURL& url);
+extern BaaTargetUrlFn g_baa_target_url;
+
+#endif  // CHROME_BROWSER_UI_BROWSER_WEB_CONTENTS_DELEGATE_BAA_TARGET_URL_HOOK_H_
