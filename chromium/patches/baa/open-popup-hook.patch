+// chrome.action.openPopup: //baa hosts the popups of its windows, which have no toolbar. Returns
+// false to leave `browser` to Chrome. Otherwise `*opened` says whether the popup is opening:
+// then the hook took `callback` and runs it once (with the host when the popup has loaded, null
+// if it closed first); if not, `callback` is left untouched.
+using BaaOpenPopupFn = bool (*)(
+    BrowserWindowInterface& browser,
+    const extensions::Extension& extension,
+    base::OnceCallback<void(extensions::ExtensionHost*)>& callback,
+    bool* opened);
+extern BaaOpenPopupFn g_baa_open_popup;
+
