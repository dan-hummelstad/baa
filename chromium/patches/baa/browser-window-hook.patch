+// baa: lets the embedding app (//baa) supply BrowserWindows. //chrome cannot
+// depend on //baa, so //baa sets this pointer.
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_BAA_BROWSER_WINDOW_HOOK_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_BAA_BROWSER_WINDOW_HOOK_H_
+
+class BrowserWindow;
+class BrowserWindowInterface;
+
+using BaaCreateBrowserWindowFn = BrowserWindow* (*)(BrowserWindowInterface*,
+                                                    bool user_gesture);
+extern BaaCreateBrowserWindowFn g_baa_create_browser_window;
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_BAA_BROWSER_WINDOW_HOOK_H_
