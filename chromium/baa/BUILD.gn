# //baa: baa's ADK-style layer (PLAN-chromium.md). Reached from
# //chrome:dependencies by chromium/patches/baa/add-baa-layer.patch, so it is
# linked into BaaCore.framework (libchrome_dll.dylib in component builds).
source_set("baa") {
  sources = [
    "app_mac.mm",
    "baa.h",
    "internal.h",
    "tab.mm",
    "window.mm",
  ]
  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/ui",
    "//chrome/browser/ui/views/frame:browser_window_factory",
    "//components/favicon/content",
    "//components/find_in_page",
    "//components/input",
    "//components/javascript_dialogs",
    "//components/permissions",
    "//components/web_modal",
    "//components/zoom",
    "//content/public/browser",
    "//ui/base",
    "//ui/events:events_base",
    "//url",
  ]
}
